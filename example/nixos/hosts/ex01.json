  "stacks": {
    "files": [
      {
        "content": "# mailrise.conf. Copy to mailrise.conf and fill in the ntfy token.\n#\n# Mailrise routes by recipient address. A key with no domain, like \"backups\",\n# matches only <key>@mailrise.xyz, mailrise's own placeholder domain, and mail\n# to any other domain is refused. Point PBS/PVE notification targets at the\n# matching address below.\n\nlisten:\n  smtp:\n    hostname: 0.0.0.0\n    port: 8025\n\nconfigs:\n  # PBS and PVE notifications -> to: backups@mailrise.xyz\n  backups:\n    urls:\n      - \"ntfy://REPLACE_WITH_NTFY_TOKEN@ntfy/alerts-backups\"\n\n  # Everything else -> to: infra@mailrise.xyz. vmalert's Alertmanager webhook\n  # can hit ntfy's own HTTP API directly instead of going through mailrise; see\n  # Phase 2's vmalert -> ntfy wiring.\n  infra:\n    urls:\n      - \"ntfy://REPLACE_WITH_NTFY_TOKEN@ntfy/alerts-infra\"\n",
        "group": 101000,
        "mode": "0600",
        "owner": 101000,
        "path": "mailrise-secrets/mailrise.conf",
        "project": "core"
      },
      {
        "content": "modules:\n  http_2xx:\n    prober: http\n    timeout: 5s\n    http:\n      valid_http_versions: [\"HTTP/1.1\", \"HTTP/2.0\"]\n      valid_status_codes: [] # defaults to 2xx\n      method: GET\n      preferred_ip_protocol: \"ip4\"\n\n  tcp_connect:\n    prober: tcp\n    timeout: 5s\n\n  icmp:\n    prober: icmp\n    timeout: 5s\n    icmp:\n      preferred_ip_protocol: \"ip4\"\n\n  dns_udp:\n    prober: dns\n    timeout: 5s\n    dns:\n      query_name: \"example.com\"\n      query_type: \"A\"\n      valid_rcodes:\n        - NOERROR\n",
        "group": 101000,
        "mode": null,
        "owner": 101000,
        "path": "blackbox-exporter-config/blackbox.yml",
        "project": "core"
      }
    ],
